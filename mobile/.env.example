# Same Supabase project as the website. Copy the public values from web/.env.local.
# The publishable key is safe in the app. Never put SUPABASE_SECRET_KEY here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The assistant, Find care, and care-team alerts call this website.
# A phone on the same Wi-Fi needs this computer's address, not localhost.
EXPO_PUBLIC_WEB_URL=https://localhost:3000
