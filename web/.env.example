# Copy to .env.local and fill in what you have.
# Without the Supabase keys, records stay in a local file on this computer.
# Without a Gemini key, health-record answers stay on the built-in rules.
# The public-site chat uses GROQ_API_KEY and never sends that key to the browser.

# ---- AI (server only — never prefix with NEXT_PUBLIC_) ----
# Get a free key at https://aistudio.google.com/apikey (Gemini API).
GEMINI_API_KEY=
# Marketing-site chat uses Groq. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Spanish: menus and buttons have built-in Spanish. Other text uses the official Google Cloud Translation API
# when this key is set, otherwise the Gemini key above, up to TRANSLATE_AI_DAILY_LIMIT model calls a day (default 200).
# GOOGLE_TRANSLATE_API_KEY=
# TRANSLATE_AI_DAILY_LIMIT=200
# Our Grok key (xAI). Used when Settings chooses Our keys and Grok.
# GROK_API_KEY=
# GROK_MODEL=grok-3
# Any OpenAI-compatible provider also works. AI_API_KEY takes priority over GEMINI_API_KEY.
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash

# ---- Google Maps (optional) ----
# Find care works without these. It uses the browser's location and OpenStreetMap.
# A server key switches the place list to Google Places. Enable "Places API (New)" and restrict the key to that API.
GOOGLE_MAPS_API_KEY=
# Browser key for Google's map tiles. Enable "Maps JavaScript API" and restrict it
# to your site's HTTP referrers (for example http://localhost:3000/*). Without it, an OpenStreetMap view is used.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID from Google Cloud > Map Management (needed for custom styling). Defaults to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---- Supabase ----
# Project URL and the publishable key are safe to send to the browser.
# The secret key stays on the server. Leave all three empty to keep the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Device sign-in (optional, server only) ----
# Each company needs its own app. Leave a pair empty and that sign-in stays unavailable.
# Redirect URLs must match exactly:
#   https://localhost:3000/api/devices/google_health/callback
#   http://localhost:3000/api/devices/oura/callback
#   http://localhost:3000/api/devices/withings/callback
# The phone opens the same company pages. Google also needs the phone address, for example
#   http://192.168.1.221:3001/api/devices/google_health/callback
# Google refuses a private address unless that URL is registered. Oura and Withings use it as the return address.
# Google Health covers Fitbit trackers and Pixel Watch: https://developers.google.com/health/setup
# Oura: https://cloud.ouraring.com/docs/authentication
# Withings: https://developer.withings.com/
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# ---- Accounts ----
# Clinicians and caregivers confirm their email before a patient can add them.
# Set to off only while the Supabase project cannot send email yet.
# CLINICIAN_EMAIL_CONFIRMATION=off

# ---- Sessions ----
# Long random string that signs the session cookie and device sign-in. Set it on the live site too.
# Without it there, a key is derived from SUPABASE_SECRET_KEY. With neither, the live site refuses to sign in.
DEMO_SESSION_SECRET=
